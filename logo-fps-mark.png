<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 320" fill="none">
  <defs>
    <linearGradient id="dg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#22D3EE"/>
      <stop offset=".5" stop-color="#8B5CF6"/>
      <stop offset="1" stop-color="#FB923C"/>
    </linearGradient>
    <style><![CDATA[
      @keyframes spin { to { transform: rotate(360deg); } }
      @keyframes hover-y { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
      @keyframes led { 0%,100% { opacity: 1; } 50% { opacity: .25; } }
      .prop { transform-box: fill-box; transform-origin: center; animation: spin 1.5s linear infinite; }
      .prop.b { animation-duration: 1.15s; animation-direction: reverse; }
      .body { transform-box: fill-box; transform-origin: center; animation: hover-y 3.6s ease-in-out infinite; }
      .led  { animation: led 1.8s ease-in-out infinite; }
      @media (prefers-reduced-motion: reduce) {
        .prop, .body, .led { animation: none; }
      }
    ]]></style>
  </defs>

  <!-- Propeller -->
  <g stroke="url(#dg)" stroke-width="2.6">
    <circle class="prop"   cx="82"  cy="82"  r="42" stroke-dasharray="9 8"/>
    <circle class="prop b" cx="238" cy="82"  r="42" stroke-dasharray="9 8"/>
    <circle class="prop b" cx="82"  cy="238" r="42" stroke-dasharray="9 8"/>
    <circle class="prop"   cx="238" cy="238" r="42" stroke-dasharray="9 8"/>
  </g>

  <g class="body">
    <!-- Ausleger -->
    <g stroke="#93A7C4" stroke-width="8" stroke-linecap="round">
      <line x1="120" y1="126" x2="88" y2="88"/>
      <line x1="200" y1="126" x2="232" y2="88"/>
      <line x1="120" y1="194" x2="88" y2="232"/>
      <line x1="200" y1="194" x2="232" y2="232"/>
    </g>

    <!-- Motoren -->
    <g fill="#0F1828" stroke="#93A7C4" stroke-width="3">
      <circle cx="82" cy="82" r="11"/>
      <circle cx="238" cy="82" r="11"/>
      <circle cx="82" cy="238" r="11"/>
      <circle cx="238" cy="238" r="11"/>
    </g>

    <!-- Rumpf -->
    <rect x="122" y="104" width="76" height="122" rx="30" fill="#0F1828" stroke="#93A7C4" stroke-width="3"/>
    <rect x="134" y="150" width="52" height="46" rx="10" stroke="#93A7C4" stroke-width="2" opacity=".4"/>
    <circle cx="160" cy="112" r="13" fill="#0F1828" stroke="#93A7C4" stroke-width="3"/>
    <circle cx="160" cy="112" r="6" fill="url(#dg)"/>
    <circle class="led" cx="146" cy="212" r="3" fill="#22D3EE"/>
    <circle class="led" cx="174" cy="212" r="3" fill="#FB923C" style="animation-delay:.9s"/>
  </g>
</svg>
